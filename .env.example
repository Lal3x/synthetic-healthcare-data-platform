# Banco da aplicacao (acesso pelo host)
APP_DB_USER=healthcare_analytics
APP_DB_PASSWORD=healthcare_analytics
APP_DB_NAME=healthcare_analytics
APP_DB_HOST=localhost
APP_DB_PORT=5432
DATABASE_URL=postgresql://healthcare_analytics:healthcare_analytics@localhost:5432/healthcare_analytics

# Banco de metadados do Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PORT=5433

# Airflow
AIRFLOW_BASE_IMAGE=apache/airflow:3.1.7
AIRFLOW_IMAGE_NAME=healthcare-analytics-airflow:3.1.7
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_JWT_SECRET=gere-uma-chave-segura-com-openssl-rand-hex-64
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
STREAMLIT_PORT=8501

# Aplicacao
APP_ENV=dev
LOG_LEVEL=INFO
SCHEMA_BRONZE=bronze
SCHEMA_SILVER=silver
SCHEMA_GOLD=gold
RAW_DATA_DIR=data/raw
